# Public browser configuration is kept in review-config.js.
# Copy this example only for future tooling; the current static frontend
# does not automatically load environment variables.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_OR_ANON_KEY
# NEVER put Supabase service_role / secret keys in browser scripts.
